{
  "name": "task-manager",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "init": "node scripts/init.js",
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "concurrently": "^9.0.0"
  }
}
